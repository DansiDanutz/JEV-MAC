{
  "name": "jev-mac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "build": "npm run native && tsc --noEmit && vite build",
    "native": "clang -Wall -Wextra -Wno-deprecated-declarations -O2 native/fsops.c -o native/fsops",
    "test": "npm run native && tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@modelcontextprotocol/sdk": "^1.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vite": "^7.0.0",
    "@playwright/test": "^1.55.0"
  }
}
